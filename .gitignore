# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# 虚拟环境
.venv/
venv/
env/

# 工具缓存
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 本仓库自己的临时目录（补丁脚本、实验产物）。python -m build 不走这里。
.tmp/

# ---------------------------------------------------------------- 运行数据
# 默认库根是 ~/.changqing（见 MemoryConfig.root），但测试、示例与基准
# 都可能把根指向仓库内，所以这里一并挡掉：**记忆库里装的是真实对话**，
# 它永远不该进版本控制。
data/
.changqing/
*.sqlite
*.sqlite3
*.sqlite-journal

# ---------------------------------------------------------------- 密钥
# .env.example 是模板，要提交；真实的 .env 一律不提交。
.env
.env.*
!.env.example

# ---------------------------------------------------------------- 模型缓存
# 本仓库默认不下载任何模型（向量能力由宿主注入 Embedder）。留一条以防万一。
.models/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

